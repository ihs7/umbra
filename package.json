{
  "name": "@ihs7/umbra",
  "version": "0.6.3",
  "description": "The Swiss-army knife of CLI generation",
  "keywords": [
    "cli",
    "cli-generator",
    "codegen",
    "hey-api",
    "openapi",
    "openapi3",
    "typescript",
    "zod"
  ],
  "homepage": "https://github.com/ihs7/umbra#readme",
  "bugs": {
    "url": "https://github.com/ihs7/umbra/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihs7/umbra.git"
  },
  "bin": {
    "umbra": "dist/generate.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src/ bin/",
    "lint:fix": "oxlint --fix src/ bin/",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=5",
    "yaml": "^2",
    "zod": "^4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
